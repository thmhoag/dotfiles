-- save all in normal and insert mode
vim.keymap.set("n", "<C-S-s>", ":wa<CR>", { noremap = true, silent = true })
vim.keymap.set("i", "<C-S-s>", "<Esc>:wa<CR>a", { noremap = true, silent = true })

